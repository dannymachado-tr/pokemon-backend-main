{
  "name": "pokemon-backend",
  "version": "1.0.0",
  "description": "Backend API for Pokemon filtering application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "esbuild server.js --bundle --platform=node --outfile=dist/server.js",
    "docker:build": "docker build -f codeCake/Dockerfile -t pokemon-backend .",
    "docker:run": "npm run deploy",
    "lint": "eslint server.js tests --ext .js --max-warnings=0",
    "test:ci": "node --test tests/*.test.js",
    "test": "node --test tests/*.test.js",
    "deploy": "sh codeCake/deploy.sh"
  },
  "keywords": [
    "pokemon",
    "api",
    "nodejs",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "eslint": "8.57.1",
    "nodemon": "^3.0.1"
  }
}
